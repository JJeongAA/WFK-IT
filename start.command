#!/bin/bash
# 맥용 실행 파일 / Файл запуску для Mac
# 더블클릭하면: 설치 + 실행 + 브라우저 자동 열기
cd "$(dirname "$0")"

echo "=================================================="
echo "   Таємний лист / 비밀편지  -  запуск / 실행"
echo "=================================================="
echo ""
echo "[1/2] Flask 설치 중... / Встановлюю Flask..."
python3 -m pip install -r requirements.txt
echo ""
echo "[2/2] 사이트 실행 중... / Запускаю сайт..."
echo "3초 뒤 브라우저가 저절로 열려요 / Браузер відкриється за 3 сек"
echo "끄려면 이 창을 닫으세요 / Щоб зупинити — закрий це вікно"
echo ""
( sleep 3; open http://127.0.0.1:5000 ) &
python3 app.py
